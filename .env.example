# Copiare in .env e valorizzare. Il file .env NON va mai committato.
# --- docker-compose (sviluppo) ---
POSTGRES_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=

# --- backend (avvio senza docker) ---
# ENVIRONMENT=development            # development | test | staging | production
# DATABASE_URL=postgresql+asyncpg://corenexus_app:<password>@localhost:5432/corenexus
# MIGRATIONS_DATABASE_URL=postgresql+asyncpg://corenexus_migrator:<password>@localhost:5432/corenexus
# APP_DB_ROLE=corenexus_app
# REDIS_URL=redis://localhost:6379/0
# APP_BASE_URL=https://agenda.corenexus.it
# PUBLIC_BOOKING_BASE_URL=https://agenda.corenexus.it/prenota
# CORS_ORIGINS=["https://agenda.corenexus.it"]
# LOG_LEVEL=INFO
# LOG_JSON=true
# SENTRY_DSN=                          # progetto Sentry in regione UE
# SENTRY_TRACES_SAMPLE_RATE=0.0
