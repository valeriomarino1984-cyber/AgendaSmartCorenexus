# Variabili dell'API (in produzione si impostano in cPanel → Setup Python App, vedi docs/07-deploy-netsons.md).
# Copiare in backend/.env per lo sviluppo locale. Il file .env NON va mai committato.
ENVIRONMENT=development                # development | test | staging | production
DATABASE_URL=mysql+pymysql://agenda_app:<password>@127.0.0.1:3306/agenda_test
MIGRATIONS_DATABASE_URL=mysql+pymysql://agenda_migr:<password>@127.0.0.1:3306/agenda_test
AUTO_MIGRATE=1
APP_BASE_URL=http://localhost:3000
PUBLIC_BOOKING_BASE_URL=http://localhost:3000/prenota
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
LOG_JSON=false
# VIDEO_BASE_URL=https://meet.jit.si   # visite online: stanza casuale per ogni appuntamento
# SENTRY_DSN=                          # progetto Sentry in regione UE
